{
    // Sets the logging level.
    // Valid values are "DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL".
    "log_level": "ERROR",

    // Whether to print raw agent messages to console for debugging.
    "debug_agent_message": false,

    // List of tools to use without confirmation.
    "allowed_tools": ["Read", "Glob", "Grep", "TodoWrite", "WebFetch", "WebSearch", "Skill"],

    // List of tools to completely disable for the agents.
    "disable_ask_user": true,

    // Whether to run terminal commands in sandbox mode.
    // When enabled, adds --sandbox to Antigravity CLI and configures sandbox permissions.
    "sandbox_mode": true,

    // Whether to share all open workspace folders with the agent.
    // If true, the agent can access files in all folders currently open in the workspace.
    // If false, the agent only has access to the agent working directory(cwd).
    "share_workspace_folders": true,

    // How markdown tables are rendered in the chat view.
    //   "bordered" — draw tables with horizontal border lines and
    //                space-aligned columns:
    //
    //     | Name | Qty |            ──────────────
    //     | ---- | --- |             Name     Qty
    //     | foo  | 1   |    ==>     ──────────────
    //     | bar  | 2   |             foo      1
    //                               ──────────────
    //                                bar      2
    //                               ──────────────
    //
    //   "markdown" — keep tables in their original markdown form
    //                (aligned, but with "|" pipe separators).
    //
    //   "html" — keep and fold the original markdown, then display a
    //            minihtml phantom. Supports **strong** and `inline code`.
    "table_style": "html",

    // Automatically fold a rendered diff when it contains more than this
    // many diff lines. Set to 0 to keep all diffs expanded.
    "diff_fold_limit": 200,

    // Number of initial diff lines as a preview when a diff
    // is folded. Set to 0 to fold the entire diff block.
    "diff_preview_lines": 5,

    // Fold each multi-line tool call to its first line once it is finished, and each run of tool
    // calls in a reply under one "⏺ N tool calls" line, so the chat reads as the agent's text.
    // Click that line (or the ⏺ of a call) to expand or collapse it.
    "fold_tool_calls": true,

    // Indent lists in agent replies by this many spaces, so they stand out from the paragraphs
    // around them. The blank line between a text line and a list is dropped, and a line ending
    // with ":" pulls in the paragraph or code block after it the same way. 0 keeps everything
    // as written. Applies to new text only.
    "list_indent": 4,

    // Keep the Chat View in a dedicated pane.
    // When true, files you open will not appear in the chat's pane.
    "dedicated_chat_pane": true,

    // Open the input pane with every chat: a small input box in its own pane under
    // the Chat View that stays visible while you scroll back through the chat.
    // "TermMate: Toggle Input Pane" opens / closes it at any time.
    "input_pane": false,

    // Underline file paths in agent replies (`src/main.py:42`, `src/main.py#L10-25`)
    // that exist on disk. Hover one for an "Open" link, or double-click it.
    // Paths inside `code` or a fenced code block are code, not links.
    "file_links": true,

    // How a file link opens: "double" (double-click; a single click still
    // places the caret / selects as usual) or "single" (one click).
    "file_links_click": "double",

    // Focus the Chat View after sending a Quick Message.
    // When false, return focus to the view where Quick Message was opened.
    "quick_message_focus_chatview": true,

    // Maximum number of recent conversation turns loaded by Resume Session.
    // Set to 0 to load the full conversation history.
    "session_history_limit": 50,

    // Whether to display the agent and model status indicator in the status bar (e.g. "▣ claude(default)").
    "show_status_indicator": true,

    // Also show the plan mode, approve mode and a "⟳" while the agent is working in
    // that status bar indicator (e.g. "⟳ ▣ claude(default) · plan:fast · approve:allow-edit").
    // The chat's own Agent / Model / PlanMode panel scrolls away with the input line;
    // the status bar stays visible.
    "status_indicator_modes": true,

    // Path or command name for the coding CLI executable.
    "claude_command": "",
    "codex_command": "",
    "pi_command": "",
    "opencode_command": "",
    "antigravity_command": "",

    // Idle grace period in seconds before shutting down the background OpenCode server
    // when all chat views are closed. Set to 0 for immediate shutdown, or -1 to keep running.
    "opencode_idle_timeout": 120,

    // Extra environment variables to inject into agent subprocesses.
    // Useful for setting API keys, or any other per-user env configuration.
    // Example:
    // "env": {
    //   "ANTHROPIC_API_KEY": "sk-ant-...",
    //   "CODEX_API_KEY": "sk-...",
    //   "OPENCODE_SERVER_PASSWORD": "secret"
    // }
    "env": {},

    // Enable file-based conversation checkpoint.
    // When true, the agent saves a checkpoint before each message so the
    // Rewind feature can restore prior states.  Only supported by the Claude
    // agent; OpenCode rewind uses its server-side session revert support.
    // This file-checkpoint setting has no effect for Codex, Pi, or OpenCode.
    "enable_file_checkpoint": true
}
