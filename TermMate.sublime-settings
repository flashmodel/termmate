{
    // Sets the logging level.
    // Valid values are "DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL".
    "log_level": "ERROR",

    // Whether to print raw agent messages to console for debugging.
    "debug_agent_message": false,

    // List of tools to use without confirmation.
    "allowed_tools": ["Read", "Glob", "Grep", "TodoWrite", "WebFetch", "WebSearch", "Skill"],

    // List of tools to completely disable for the agents.
    "disable_ask_user": true,

    // Whether to share all open workspace folders with the agent.
    // If true, the agent can access files in all folders currently open in the workspace.
    // If false, the agent only has access to the agent working directory(cwd).
    "share_workspace_folders": true,

    // How markdown tables are rendered in the chat view.
    //   "bordered" — draw tables with horizontal border lines and
    //                space-aligned columns:
    //
    //     | Name | Qty |            ──────────────
    //     | ---- | --- |             Name     Qty
    //     | foo  | 1   |    ==>     ──────────────
    //     | bar  | 2   |             foo      1
    //                               ──────────────
    //                                bar      2
    //                               ──────────────
    //
    //   "markdown" — keep tables in their original markdown form
    //                (aligned, but with "|" pipe separators).
    "table_style": "bordered",

    // Keep the Chat View in a dedicated pane.
    // When true, files you open will not appear in the chat's pane.
    "dedicated_chat_pane": true,

    // Focus the Chat View after sending a Quick Message.
    // When false, return focus to the view where Quick Message was opened.
    "quick_message_focus_chatview": true,

    // Path or command name for the coding CLI executable.
    "claude_command": "",
    "codex_command": "",
    "pi_command": "",
    "opencode_command": "",

    // Optional URL of an already-running OpenCode server. When empty, TermMate
    // starts `opencode serve` on an OS-assigned free port for each chat agent,
    // avoiding port collisions when multiple agents run concurrently.
    "opencode_server_url": "",

    // Extra environment variables to inject into agent subprocesses.
    // Useful for setting API keys, or any other per-user env configuration.
    // Example:
    // "env": {
    //   "ANTHROPIC_API_KEY": "sk-ant-...",
    //   "CODEX_API_KEY": "sk-...",
    //   "OPENCODE_SERVER_PASSWORD": "secret"
    // }
    "env": {},

    // Enable file-based conversation checkpoint.
    // When true, the agent saves a checkpoint before each message so the
    // Rewind feature can restore prior states.  Only supported by the Claude
    // agent; OpenCode rewind uses its server-side session revert support.
    // This file-checkpoint setting has no effect for Codex, Pi, or OpenCode.
    "enable_file_checkpoint": true
}
