%YAML 1.2
---
# http://www.sublimetext.com/docs/syntax.html
name: ChatMD
hidden: true
scope: text.html.markdown.chatview
version: 2

contexts:
  main:
    # 1. Agent response separator indicator (matches Markdown thematic break --- scoping)
    - match: '^(⋅⋅⋅)\s*$'
      scope: meta.separator.thematic-break.markdown
      captures:
        1: punctuation.definition.thematic-break.markdown punctuation.definition.separator.markdown
      embed: agent_content
      escape: '^(?=(?:⋅⋅⋅|❯ ))'
      escape_captures:
        0: meta.separator.thematic-break.markdown

    # 2. User prompt marker (isolated prompt scope via embed + escape)
    - match: '^(❯ )'
      scope: punctuation.definition.prompt.chatview
      embed: user_prompt_content
      escape: '^(?=(?:⋅⋅⋅|❯ ))'

    # 3. Initial/fallback content (welcome banner, cwd, etc.)
    - include: agent_content

  user_prompt_content:
    - include: scope:text.html.markdown#markdown

  agent_content:
    - match: '^(⏺\s*(?:Read|Edit|Write|read|edit|write|fileChange|ViewFile|EditFile|WriteFile)\s+)(\S+.*)$'
      captures:
        1: entity.name.function.chatview
        2: variable.function.chatview
    - match: '^(⏺\s*\S+)(.*)$'
      captures:
        1: entity.name.function.chatview
    - match: '^(▣\s*)((?:\d+\s+)?files?\s+(?:changed|changes).*)$'
      captures:
        1: variable.parameter.chatview
        2: variable.parameter.chatview
      push: artifact_file_list
    - match: '^(▣\s*)(\S.*)$'
      captures:
        1: variable.parameter.chatview
        2: variable.function.chatview
    - match: '^■ .*$'
      scope: variable.parameter.chatview
    - match: '^[ \t]*(`{3,})((?i:diff)\b.*)$'
      scope: meta.code-fence.definition.begin.markdown-gfm
      captures:
        1: punctuation.definition.raw.code-fence.begin.markdown
        2: constant.other.language-name.markdown
      push: diff_block
    - include: scope:text.html.markdown#markdown

  diff_block:
    - meta_scope: meta.code-fence.body.markdown-gfm markup.raw.code-fence.diff.markdown-gfm source.diff
    - match: '^[ \t]*(`{3,})[ \t]*$'
      scope: meta.code-fence.definition.end.markdown-gfm punctuation.definition.raw.code-fence.end.markdown
      pop: true
    - match: '^(?:  |)(@@\s*-\d+(?:,\d+)?\s*\+\d+(?:,\d+)?\s*@@)(.*)$'
      scope: meta.diff.range.unified
      captures:
        1: variable.function.chatview punctuation.definition.range.diff
        2: comment.line.diff
    - match: '^(?:  |)(-)(.*)$'
      scope: meta.diff.line.deleted markup.deleted.diff
      captures:
        1: punctuation.definition.deleted.diff
    - match: '^(?:  |)(\+)(.*)$'
      scope: meta.diff.line.inserted markup.inserted.diff
      captures:
        1: punctuation.definition.inserted.diff
    - match: '^(?:  |) (.*)$'
      scope: meta.diff.line.context

  artifact_file_list:
    - match: '^    (\S.*?)(\s{2,})(\+\d+)(\s+)(-\d+)\s*$'
      captures:
        1: variable.function.chatview
        3: markup.inserted.diff
        5: markup.deleted.diff
    - match: '^    \S.*$'
      captures:
        0: variable.function.chatview
    - match: '^(?!    )'
      pop: true